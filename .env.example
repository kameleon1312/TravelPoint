# ============================================================
# TravelPoint — Environment Variables Example
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/travelpoint

# --- JWT (generate with: openssl rand -base64 32) ---
JWT_ACCESS_SECRET=CHANGE_ME_256bit_secret_access
JWT_REFRESH_SECRET=CHANGE_ME_256bit_secret_refresh

# --- Encryption (AES-256-GCM, base64 of 32 bytes) ---
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=CHANGE_ME_base64_32bytes

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Mapbox ---
NEXT_PUBLIC_MAPBOX_TOKEN=pk.CHANGE_ME
MAPBOX_SECRET_TOKEN=sk.CHANGE_ME

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=travelpoint-media

# --- Resend (email) ---
RESEND_API_KEY=re_CHANGE_ME

# --- Sentry ---
SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
NEXT_PUBLIC_SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME

# --- App URLs ---
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
APP_URL=http://localhost:3000

# --- Log level ---
LOG_LEVEL=info
