# ============================================================
# TravelPoint — Environment Variables
# Copy to .env (root) and apps/api/.env, fill in real values.
# NEVER commit .env files — they are in .gitignore.
# ============================================================

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Session-mode pooler URL (port 5432) — used by Prisma at runtime
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Direct URL (non-pooled) — required by Prisma for migrations
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ── JWT (generate: openssl rand -base64 32) ──────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars

# ── Encryption (AES-256-GCM, base64 of 32 bytes) ─────────────────────────────
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=CHANGE_ME_base64_32bytes

# ── Redis (Upstash recommended) ───────────────────────────────────────────────
# Leave empty for MVP — reserved for Sprint 3
REDIS_URL=redis://localhost:6379

# ── Mapbox ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.CHANGE_ME
MAPBOX_SECRET_TOKEN=sk.CHANGE_ME
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=CHANGE_ME
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# ── Cloudflare R2 (photo storage — required before closed MVP) ────────────────
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=travelpoint-media
R2_PUBLIC_URL=https://media.travelpoint.app
JOB_SECRET=CHANGE_ME_min_32_chars

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get key: https://resend.com/api-keys
RESEND_API_KEY=re_CHANGE_ME
# DEV:  TravelPoint <onboarding@resend.dev>
# PROD: TravelPoint <noreply@travelpoint.app>  (requires verified domain in Resend)
EMAIL_FROM=TravelPoint <onboarding@resend.dev>
# Receives RODO request notifications
DPO_EMAIL=privacy@travelpoint.app

# ── Sentry ────────────────────────────────────────────────────────────────────
# Create 3 projects in your Sentry org: travelpoint-api, travelpoint-web, travelpoint-mobile
# DSN: Sentry project → Settings → Client Keys
SENTRY_DSN=https://CHANGE_ME@CHANGE_ME.ingest.sentry.io/CHANGE_ME
NEXT_PUBLIC_SENTRY_DSN=https://CHANGE_ME@CHANGE_ME.ingest.sentry.io/CHANGE_ME
EXPO_PUBLIC_SENTRY_DSN=https://CHANGE_ME@CHANGE_ME.ingest.sentry.io/CHANGE_ME

# Source maps upload — CI only (Sentry → Settings → Auth Tokens → Create)
SENTRY_AUTH_TOKEN=CHANGE_ME
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=travelpoint-web

# ── App URLs ──────────────────────────────────────────────────────────────────
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Production (uncomment after first deploy):
# API_URL=https://api.travelpoint.app
# NEXT_PUBLIC_API_URL=https://api.travelpoint.app
# NEXT_PUBLIC_APP_URL=https://travelpoint.app
# ALLOWED_ORIGINS=https://travelpoint.app,https://www.travelpoint.app

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
PORT=4000
APP_VERSION=1.0.0
