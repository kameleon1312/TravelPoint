{
  "name": "travelpoint",
  "private": true,
  "scripts": {
    "dev:mobile": "pnpm --filter @travelpoint/mobile dev",
    "dev:web": "pnpm --filter @travelpoint/web dev",
    "dev:api": "pnpm --filter @travelpoint/api dev",
    "dev": "pnpm run --parallel /^dev:.*/",
    "build:packages": "pnpm --filter @travelpoint/geo --filter @travelpoint/types --filter @travelpoint/utils --filter @travelpoint/validation build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "gate:pre-sprint3": "node tools/check-pre-sprint3.cjs",
    "gate:production": "node tools/check-production-readiness.cjs",
    "smoke:preview": "node tools/smoke-preview.cjs",
    "smoke:production": "node tools/smoke-production.cjs",
    "security:secrets": "node tools/secret-scan.cjs",
    "security:audit": "node tools/audit-critical.cjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.16",
    "prettier": "^3.2.0",
    "typescript": "^6.0.0"
  },
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-23hp-3jrh-7fpw"
      ]
    },
    "overrides": {
      "tar": "^7.5.19",
      "rollup": "^3.30.0",
      "undici": "^6.27.0",
      "ws": "^8.21.0",
      "vite": "^6.4.3",
      "js-yaml@3": "^3.15.0",
      "js-yaml@4": "^4.3.0",
      "shell-quote": "^1.8.5",
      "fast-uri": "^3.1.4",
      "nanoid": "^3.3.17",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2"
    },
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "@node-rs/argon2",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
