{
  "name": "travelpoint",
  "private": true,
  "scripts": {
    "dev:mobile": "pnpm --filter @travelpoint/mobile dev",
    "dev:web": "pnpm --filter @travelpoint/web dev",
    "dev:api": "pnpm --filter @travelpoint/api dev",
    "dev": "pnpm run --parallel /^dev:.*/",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "prettier": "^3.2.0",
    "eslint": "^8.57.0"
  },
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@sentry/cli", "@node-rs/argon2", "esbuild", "sharp"]
  }
}
