{
  "name": "travelpoint",
  "private": true,
  "scripts": {
    "dev:mobile": "pnpm --filter @travelpoint/mobile dev",
    "dev:web": "pnpm --filter @travelpoint/web dev",
    "dev:api": "pnpm --filter @travelpoint/api dev",
    "dev": "pnpm run --parallel /^dev:.*/",
    "build:packages": "pnpm --filter @travelpoint/geo --filter @travelpoint/types --filter @travelpoint/utils --filter @travelpoint/validation build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "gate:pre-sprint3": "node tools/check-pre-sprint3.cjs",
    "smoke:preview": "node tools/smoke-preview.cjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "prettier": "^3.2.0",
    "typescript": "^6.0.0"
  },
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "@node-rs/argon2",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
