{
  "name": "@travelpoint/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm -w run build:packages",
    "build": "pnpm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretype-check": "pnpm run db:generate",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "pretest": "pnpm -w run build:packages",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1067.0",
    "@aws-sdk/s3-request-presigner": "^3.1067.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.14.0",
    "@sentry/node": "^8.0.0",
    "@travelpoint/geo": "workspace:*",
    "@travelpoint/types": "workspace:*",
    "@travelpoint/utils": "workspace:*",
    "@travelpoint/validation": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.7.2",
    "fastify-plugin": "^5.1.0",
    "h3-js": "^4.4.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.21.0",
    "pino": "^9.1.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "prisma": "^5.14.0",
    "tsx": "^4.15.0",
    "typescript": "^6.0.0",
    "vitest": "^3.2.6"
  }
}
