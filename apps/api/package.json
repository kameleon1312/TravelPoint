{
  "name": "@travelpoint/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.14.0",
    "@travelpoint/geo": "workspace:*",
    "@travelpoint/types": "workspace:*",
    "@travelpoint/utils": "workspace:*",
    "@travelpoint/validation": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^4.27.0",
    "fastify-plugin": "^5.1.0",
    "h3-js": "^4.4.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.21.0",
    "pino": "^9.1.0",
    "resend": "^3.2.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "prisma": "^5.14.0",
    "tsx": "^4.15.0",
    "typescript": "^6.0.0",
    "vitest": "^1.6.0"
  }
}
