{
  "expo": {
    "name": "TravelPoint",
    "slug": "travelpoint",
    "version": "1.0.0",
    "scheme": "travelpoint",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E18"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.travelpoint.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TravelPoint uses your location to show nearby explorers and hidden spots. Location is optional and always opt-in.",
        "NSLocationAlwaysUsageDescription": "TravelPoint can use background location for journey tracking. This is always opt-in."
      }
    },
    "android": {
      "package": "io.travelpoint.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0E18"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCOFZOado8hNdIGCjZuEAG5iTJrQlmRFCM"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "TravelPoint uses your photo library to add photos to spots.",
          "cameraPermission": "TravelPoint uses your camera to take photos of spots."
        }
      ],
      [
        "expo-notifications",
        { "icon": "./assets/images/icon.png", "color": "#5CB88C" }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "pawflo",
          "project": "travelpoint-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fbd06b46-7ace-4d3e-bc29-6b51fcaf6453"
      },
      "sentryDsn": "https://69fc58ab49a261c1bd4d4ea0f76d7cc9@o4511354565165056.ingest.de.sentry.io/4511497658040400"
    },
    "owner": "pawflo"
  }
}
